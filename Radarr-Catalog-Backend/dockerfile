FROM --platform=linux/amd64 amazoncorretto:21-alpine as builder

ARG APP=radarr-catalog
ENV APP=$APP

WORKDIR /app/$APP

COPY ./.mvn ./.mvn
COPY ./mvnw .
COPY ./pom.xml .

RUN chmod +x ./mvnw

RUN ./mvnw clean package -Dmaven.test.skip -Dmaven.main.skip -Dspring-boot.repackage.skip && rm -r ./target/

COPY ./src ./src
RUN ./mvnw clean package -DskipTests

FROM --platform=linux/amd64 amazoncorretto:21-alpine

WORKDIR /app

RUN mkdir -p /app/logs

COPY --from=builder /app/radarr-catalog/target/radarr-catalog-0.0.1-SNAPSHOT.jar app.jar

ARG PORT_APP=8080
ENV PORT=$PORT_APP

EXPOSE $PORT

CMD ["java", "-jar", "app.jar"]